# Registry oficial (npmmirror daba timeouts y no soporta auditoría)
registry=https://registry.npmjs.org/
audit-config-registry=https://registry.npmjs.org/

# Hoisting selectivo: ESLint, Prettier y TypeScript necesitan ver estas deps
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=@types/*