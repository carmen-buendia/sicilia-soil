{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@sicilia-soil/core": ["./packages/core/src"],
      "@sicilia-soil/core/*": ["./packages/core/src/*"],
      "@sicilia-soil/ui": ["./packages/ui/src"],
      "@sicilia-soil/ui/*": ["./packages/ui/src/*"],
      "@sicilia-soil/utils": ["./packages/utils/src"],
      "@sicilia-soil/utils/*": ["./packages/utils/src/*"],
      "@sicilia-soil/db": ["./packages/db/src"],
      "@sicilia-soil/db/*": ["./packages/db/src/*"],
      "@isola-node/rule-engine": ["./packages/rule-engine/src"],
      "@isola-node/rule-engine/*": ["./packages/rule-engine/src/*"],
      "@isola-node/sync": ["./packages/sync/src"],
      "@isola-node/sync/*": ["./packages/sync/src/*"],
      "@isola-node/edge": ["./packages/edge/src"],
      "@isola-node/edge/*": ["./packages/edge/src/*"],
      "@isola-node/adapters": ["./packages/adapters/src"],
      "@isola-node/adapters/*": ["./packages/adapters/src/*"]
    }
  },
  "exclude": ["node_modules", "apps/*/node_modules", "packages/*/node_modules"]
}
