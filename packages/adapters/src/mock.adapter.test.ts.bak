import { describe, it, expect } from "vitest";
import { MockDataAdapter } from "./mock.adapter";

type Reading = { timestamp: string; value: number };

describe("MockDataAdapter", () => {
  const adapter = new MockDataAdapter<Reading>({
    metadata: { id: "test", kind: "mock", name: "Test source" },
    data: [
      { timestamp: "2026-10-01T00:00:00Z", value: 10 },
      { timestamp: "2026-10-05T00:00:00Z", value: 50 },
      { timestamp: "2026-10-03T00:00:00Z", value: 30 },
    ],
    getTimestamp: (r) => r.timestamp,
  });

  it("is always available", async () => {
    expect(await adapter.isAvailable()).toBe(true);
  });

  it("filters readings by range", async () => {
    const result = await adapter.getReadings({
      from: "2026-10-01T00:00:00Z",
      to: "2026-10-03T00:00:00Z",
    });
    expect(result).toHaveLength(2);
  });

  it("returns series sorted by timestamp", async () => {
    const result = await adapter.getSeries({
      from: "2026-10-01T00:00:00Z",
      to: "2026-10-05T00:00:00Z",
    });
    expect(result[0].value).toBe(10);
    expect(result[1].value).toBe(30);
    expect(result[2].value).toBe(50);
  });
});
