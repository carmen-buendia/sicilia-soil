{
  "name": "@sicilia-soil/utils",
  "version": "0.0.1",
  "description": "Utility functions for SikeliaSoil",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@sicilia-soil/core": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5.3.3"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  }
}
