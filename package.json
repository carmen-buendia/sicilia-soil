{
  "name": "sicilia-soil",
  "version": "1.0.0",
  "private": true,
  "description": "Permaculture monitoring system",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run --parallel build",
    "build:web": "pnpm --filter web build",
    "build:core": "pnpm --filter @sicilia-soil/core build",
    "build:ui": "pnpm --filter @sicilia-soil/ui build",
    "build:utils": "pnpm --filter @sicilia-soil/utils build",
    "lint": "pnpm -r --if-present lint",
    "type-check": "pnpm run --parallel type-check",
    "test": "pnpm -r test",
    "clean": "pnpm store prune && rimraf node_modules **/node_modules"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.8.2",
    "vitest": "3"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "qs": ">=6.16.0",
      "minimatch@3>brace-expansion": "1.1.21",
      "minimatch@9>brace-expansion": ">=2.1.7",
      "minimatch@9": ">=9.0.7",
      "source-map-js": ">=1.2.2",
      "sharp": ">=0.35.5",
      "postcss-selector-parser": ">=7.1.6"
    }
  }
}
