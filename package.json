{
  "name": "sicilia-business-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Suite de gestión con WebRTC para negocios sicilianos",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:webrtc": "pnpm --filter webrtc-server dev",
    "dev:all": "pnpm -r dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "setup": "powershell -File ./scripts/setup.ps1",
    "create:webrtc": "powershell -File ./scripts/create-webrtc.ps1",
    "clean": "pnpm store prune && rimraf node_modules **/node_modules"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@8.15.0"
}
